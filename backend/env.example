# =====================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git — it contains secrets!
# =====================================================

# =====================================================
# SERVER
# =====================================================

PORT=8000
NODE_ENV=development

# =====================================================
# APPLICATION
# =====================================================

APP_NAME=Support Pilot

# Change this to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret

# =====================================================
# DATABASE
# =====================================================

# Local development — uses SQLite, zero setup needed:
DATABASE_URL=sqlite:///./supportpilot.db

# Production (Render PostgreSQL) — set this in Render's Environment tab:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# =====================================================
# BREVO EMAIL (transactional email)
# =====================================================

BREVO_API_KEY=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
EMAIL_FROM_NAME=Support Pilot
EMAIL_FROM=your-email@example.com
